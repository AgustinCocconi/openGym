[Unit]
Description=Registro de salud y recursos openGym
RequiresMountsFor=/srv/opengym /srv/opengym-observation
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/srv/opengym
UMask=0077
ExecStart=/usr/bin/python3 /srv/opengym/ops/observe-production.py sample
TimeoutStartSec=90