# Copy to terraform.tfvars. The real file is ignored by Git.
# OCIDs and public keys are not passwords, but keeping machine/account-specific
# values local avoids publishing unnecessary identifiers.

tenancy_ocid     = "ocid1.tenancy.oc1..replace-me"
compartment_ocid = "ocid1.compartment.oc1..replace-me"
ssh_public_key   = "ssh-ed25519 AAAA-replace-with-your-public-key opengym-operator"

# Use the current public IPv4 of the operator as a /32. Never use 0.0.0.0/0.
bastion_client_cidr_blocks = ["203.0.113.10/32"]

# Leave null to select the latest compatible Ubuntu 24.04 AMD64 platform image
# during plan. After reviewing the first plan, this can be pinned to that OCID.
image_ocid = null
