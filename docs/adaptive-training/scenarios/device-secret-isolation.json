{
  "scenarioVersion": "adaptive-training-scenario/v1",
  "id": "device-secret-isolation",
  "purpose": "Mantener las credenciales del dispositivo fuera de estado, archivos de metadatos y restauraciones de otro dispositivo.",
  "given": {
    "credentialKinds": ["paired_bearer", "coach_api_key"],
    "platforms": ["native_android", "native_ios", "mobile_build_in_browser"],
    "legacyPairingHasPlaintextToken": true
  },
  "when": {
    "actions": ["pair", "migrate_legacy_pairing", "reload", "disconnect", "restore_metadata_without_secret"],
    "failureVariant": "native_secure_storage_unavailable"
  },
  "expect": {
    "invariants": [
      "native_credentials_use_device_secure_storage_without_cloud_sync",
      "web_credentials_are_memory_only_and_old_web_key_is_removed",
      "pairing_metadata_excludes_bearer",
      "legacy_migration_requires_secure_persistence_before_use",
      "native_pairing_fails_when_durable_secret_storage_fails",
      "disconnect_clears_device_secret",
      "metadata_alone_cannot_restore_authentication",
      "android_legacy_cloud_and_device_transfer_rules_exclude_pairing_and_secure_preferences"
    ],
    "forbidden": ["secret_in_training_export", "web_plugin_persists_api_key", "pairing_activates_after_secure_write_failure"]
  }
}
