#cloud-config
package_update: true
package_upgrade: false

packages:
  - ca-certificates
  - curl
  - e2fsprogs
  - git
  - jq
  - tar
  - ufw
  - unzip

write_files:
  - path: /etc/opengym-host.env
    owner: root:root
    permissions: "0644"
    content: |
      OPENGYM_PUBLIC_HOSTNAME=${public_hostname}
      OPENGYM_DATA_DEVICE=${data_device}
      OPENGYM_MOUNT_POINT=${mount_point}
      OPENGYM_OPERATOR_USER=${operator_user}

  - path: /usr/local/sbin/opengym-mount-volume
    owner: root:root
    permissions: "0750"
    content: |
      #!/usr/bin/env sh
      set -eu

      device='${data_device}'
      mount_point='${mount_point}'
      operator='${operator_user}'

      [ -b "$device" ] || {
        echo "Waiting for persistent volume at $device" >&2
        exit 1
      }

      fs_type=$(blkid -o value -s TYPE "$device" 2>/dev/null || true)
      if [ -z "$fs_type" ]; then
        mkfs.ext4 -F -L opengym-data "$device"
        fs_type=ext4
      fi
      [ "$fs_type" = ext4 ] || {
        echo "Unexpected filesystem on $device: $fs_type" >&2
        exit 1
      }

      volume_uuid=$(blkid -o value -s UUID "$device")
      [ -n "$volume_uuid" ] || {
        echo "Unable to read filesystem UUID from $device" >&2
        exit 1
      }

      mkdir -p "$mount_point"
      if ! grep -Fq "UUID=$volume_uuid $mount_point " /etc/fstab; then
        printf 'UUID=%s %s ext4 defaults,nofail,_netdev 0 2\n' "$volume_uuid" "$mount_point" >> /etc/fstab
      fi
      mountpoint -q "$mount_point" || mount "$mount_point"

      install -d -o "$operator" -g "$operator" -m 0750 \
        "$mount_point/opengym" \
        "$mount_point/opengym-backups"
      touch "$mount_point/.opengym-data-volume"
      chown "$operator:$operator" "$mount_point/.opengym-data-volume"

  - path: /etc/systemd/system/opengym-data-volume.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Prepare the persistent openGym block volume
      After=cloud-init.service
      StartLimitIntervalSec=0

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/opengym-mount-volume
      RemainAfterExit=yes
      Restart=on-failure
      RestartSec=10s

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/sbin/opengym-host-bootstrap
    owner: root:root
    permissions: "0750"
    content: |
      #!/usr/bin/env sh
      set -eu
      export DEBIAN_FRONTEND=noninteractive

      install -m 0755 -d /etc/apt/keyrings /usr/share/keyrings

      if [ ! -f /etc/apt/keyrings/docker.asc ]; then
        curl --fail --silent --show-error --location \
          https://download.docker.com/linux/ubuntu/gpg \
          --output /etc/apt/keyrings/docker.asc
        chmod a+r /etc/apt/keyrings/docker.asc
      fi
      cat > /etc/apt/sources.list.d/docker.sources <<'EOF'
      Types: deb
      URIs: https://download.docker.com/linux/ubuntu
      Suites: noble
      Components: stable
      Architectures: arm64
      Signed-By: /etc/apt/keyrings/docker.asc
      EOF

      if [ ! -f /usr/share/keyrings/cloudflare-main.gpg ]; then
        curl --fail --silent --show-error --location \
          https://pkg.cloudflare.com/cloudflare-main.gpg \
          --output /usr/share/keyrings/cloudflare-main.gpg
      fi
      printf '%s\n' \
        'deb [signed-by=/usr/share/keyrings/cloudflare-main.gpg] https://pkg.cloudflare.com/cloudflared noble main' \
        > /etc/apt/sources.list.d/cloudflared.list

      apt-get update
      apt-get install -y \
        cloudflared \
        containerd.io \
        docker-buildx-plugin \
        docker-ce \
        docker-ce-cli \
        docker-compose-plugin

      usermod -aG docker '${operator_user}'
      systemctl enable --now docker.service
      systemctl disable --now cloudflared.service 2>/dev/null || true

      ufw --force reset
      ufw default deny incoming
      ufw default allow outgoing
      ufw allow from '${bastion_private_ip}' to any port 22 proto tcp
      ufw --force enable

      systemctl daemon-reload
      systemctl enable opengym-data-volume.service
      systemctl start opengym-data-volume.service || true

      docker --version
      docker compose version
      cloudflared --version

runcmd:
  - [sh, -c, "/usr/local/sbin/opengym-host-bootstrap > /var/log/opengym-host-bootstrap.log 2>&1"]

final_message: "openGym host bootstrap finished. Tunnel credentials were intentionally not installed."
